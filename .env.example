# ⚡ AI Workflow Designer - Environment Configuration Example

# Google AI API Key hoặc Anthropic API Key (Sử dụng cho trình chấm điểm AI-as-a-judge)
# Lưu ý: Các biến bắt đầu bằng VITE_ sẽ được đóng gói vào client bundle và có thể bị lộ trên trình duyệt.
# Cân nhắc sử dụng API Proxy trên production.
VITE_API_KEY=your_api_key_here

# Giới hạn số lần gọi AI-as-a-judge tối đa trong một phiên làm việc (Session) để tránh lạm dụng / vượt quá hạn mức
VITE_AI_JUDGE_MAX_CALLS=10
